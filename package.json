{
  "name": "@milkyway-666/tempo",
  "version": "0.1.0",
  "description": "Tempo — a personal, chat-driven work tracker. Narrate your work to an agent; it appends an event log and derives your board, time, and plans. Runs as a local MCP server for Claude Code.",
  "type": "module",
  "bin": {
    "tempo": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/bin.ts --format esm --target node20 --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "claude",
    "time-tracking",
    "kanban",
    "productivity",
    "event-sourcing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milky-way-66/tempo.git"
  },
  "bugs": {
    "url": "https://github.com/milky-way-66/tempo/issues"
  },
  "homepage": "https://github.com/milky-way-66/tempo#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0",
    "luxon": "^3.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
